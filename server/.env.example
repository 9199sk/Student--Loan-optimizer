# Server Port
PORT=5000

# Database Connection (MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/loan-optimizer?retryWrites=true&w=majority

# JWT Security
JWT_SECRET=your_production_super_secret_jwt_key
JWT_EXPIRES_IN=7d

# Environment
NODE_ENV=production

# Frontend Allowed Origin (Vercel deployment URL)
CLIENT_URL=https://your-frontend-app.vercel.app
CLIENT_ORIGIN=https://your-frontend-app.vercel.app
